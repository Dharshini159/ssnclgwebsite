* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: #222;
    line-height: 1.6;
    background: #ffffff;
}

a {
    text-decoration: none;
}

img {
    width: 100%;
    display: block;
}




.top-bar {
    background: #111827;
    color: white;
    padding: 9px 6%;
    display: flex;
    justify-content: space-between;
    font-size: 13px;
}


/* =========================
   NAVBAR
========================= */

.navbar {
    background: white;
    padding: 15px 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo-box {
    width: 52px;
    height: 52px;
    background: #c69214;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    font-size: 17px;
    border-radius: 4px;
}

.logo h2 {
    font-size: 20px;
    color: #111827;
}

.logo span {
    font-size: 10px;
    letter-spacing: 1.5px;
    color: #666;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 24px;
}

.nav-links a {
    color: #333;
    font-weight: 600;
    font-size: 14px;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #c69214;
}

.menu-btn {
    display: none;
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: #111827;
}




.hero {
    min-height: 78vh;

    background:
        linear-gradient(
            rgba(10, 20, 35, 0.72),
            rgba(10, 20, 35, 0.60)
        ),
        url("https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=1600&q=80");

    background-size: cover;
    background-position: center;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;

    color: white;
}

.hero-content {
    max-width: 900px;
    padding: 30px;
}

.hero-small {
    letter-spacing: 4px;
    color: #f0c75e;
    font-weight: bold;
    margin-bottom: 12px;
}

.hero h1 {
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.1;
    margin-bottom: 20px;
}

.hero-content > p:not(.hero-small) {
    font-size: 20px;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    justify-content: center;
    gap: 15px;
}

.btn {
    display: inline-block;
    padding: 13px 28px;
    border-radius: 4px;
    font-weight: bold;
    transition: 0.3s;
}

.primary {
    background: #c69214;
    color: white;
}

.primary:hover {
    background: white;
    color: #111827;
}

.secondary {
    border: 2px solid white;
    color: white;
}

.secondary:hover {
    background: white;
    color: #111827;
}




.notice {
    display: flex;
    align-items: center;
    background: #f5f5f5;
    border-bottom: 1px solid #ddd;
}

.notice-title {
    background: #c69214;
    color: white;
    padding: 13px 30px;
    font-weight: bold;
}

.notice-text {
    padding: 13px 25px;
    color: #555;
}



section {
    padding: 80px 7%;
}

.section-heading {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 50px;
}

.section-heading p,
.section-title {
    color: #c69214;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 3px;
    margin-bottom: 8px;
}

.section-heading h2,
.contact h2 {
    font-size: 38px;
    margin-bottom: 10px;
    color: #111827;
}

.section-heading span {
    color: #777;
}



.about-section {
    background: white;
}

.about-container {
    max-width: 1200px;
    margin: auto;

    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 50px;

    align-items: center;
}

.about-image img {
    height: 400px;
    object-fit: cover;
    border-radius: 6px;
}

.about-content h3 {
    font-size: 30px;
    color: #111827;
    margin-bottom: 15px;
}

.about-content p {
    color: #666;
    margin-bottom: 15px;
}

.read-btn {
    background: #111827;
    color: white;
    border: none;
    padding: 12px 25px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
}

.read-btn:hover {
    background: #c69214;
}




.statistics {
    padding: 55px 7%;
    background: #111827;
    color: white;

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    text-align: center;
    gap: 20px;
}

.stat {
    border-right: 1px solid rgba(255, 255, 255, 0.25);
}

.stat:last-child {
    border-right: none;
}

.stat h2 {
    color: #f0c75e;
    font-size: 36px;
}

.stat p {
    font-size: 14px;
}




.departments {
    background: #f7f7f7;
}

.department-container {
    max-width: 1200px;
    margin: auto;

    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.department-card {
    background: white;
    padding: 30px;

    border-top: 4px solid #c69214;

    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);

    transition: 0.3s;
}

.department-card:hover {
    transform: translateY(-7px);
}

.department-icon {
    font-size: 40px;
    margin-bottom: 15px;
}

.department-card h3 {
    color: #111827;
    margin-bottom: 10px;
}

.department-card p {
    color: #666;
    margin-bottom: 20px;
}

.department-card button {
    background: none;
    border: none;
    color: #b17d00;
    font-weight: bold;
    cursor: pointer;
}



.programmes {
    background: white;
}

.program-container {
    max-width: 1100px;
    margin: auto;

    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.program-card {
    padding: 35px;

    background: #111827;
    color: white;

    border-radius: 5px;

    transition: 0.3s;
}

.program-card:hover {
    transform: translateY(-5px);
}

.program-icon {
    font-size: 38px;
    margin-bottom: 15px;
}

.program-card h3 {
    color: #f0c75e;
    margin-bottom: 12px;
}

.program-card p {
    margin-bottom: 20px;
    color: #eee;
}

.program-card a {
    color: #f0c75e;
    font-weight: bold;
}



.facilities {
    background: #f7f7f7;
}

.facility-container {
    max-width: 1100px;
    margin: auto;

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 25px;
}

.facility {
    text-align: center;

    background: white;

    padding: 30px 20px;

    border: 1px solid #eee;

    transition: 0.3s;
}

.facility:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
}

.facility span {
    font-size: 42px;
}

.facility h3 {
    margin: 15px 0 8px;
    color: #111827;
}

.facility p {
    color: #777;
}


/* =========================
   ADMISSIONS
========================= */

.admissions {
    background: #eeeeee;
}

#admissionForm {
    max-width: 850px;
    margin: auto;

    background: white;

    padding: 40px;

    border-radius: 5px;

    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 20px;

    margin-bottom: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    font-weight: bold;
    margin-bottom: 7px;
}

.form-group input,
.form-group select {
    padding: 13px;

    border: 1px solid #ddd;

    border-radius: 4px;

    outline: none;

    font-size: 15px;
}

.form-group input:focus,
.form-group select:focus {
    border-color: #c69214;
}

.submit-btn {
    width: 100%;

    padding: 14px;

    background: #111827;

    color: white;

    border: none;

    border-radius: 4px;

    font-size: 16px;

    font-weight: bold;

    cursor: pointer;
}

.submit-btn:hover {
    background: #c69214;
}



.contact {
    max-width: 1200px;
    margin: auto;
}

.contact-container {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 50px;

    align-items: center;
}

.contact-container p:not(.section-title) {
    color: #666;
    margin: 15px 0;
}

.contact-card {
    background: #111827;

    color: white;

    padding: 40px;

    border-radius: 5px;
}

.contact-card h3 {
    color: #f0c75e;

    margin-bottom: 10px;
}

.contact-card button {
    margin-top: 20px;

    padding: 12px 25px;

    border: none;

    background: #c69214;

    color: white;

    font-weight: bold;

    cursor: pointer;

    border-radius: 4px;
}

.contact-card button:hover {
    background: white;
    color: #111827;
}


/* =========================
   FOOTER
========================= */

footer {
    background: #080d16;

    color: white;

    text-align: center;

    padding: 35px 20px;
}

.footer-logo {
    color: #f0c75e;

    font-size: 25px;

    font-weight: bold;

    margin-bottom: 8px;
}


/* =========================
   TABLET
========================= */

@media (max-width: 900px) {

    .department-container {
        grid-template-columns: 1fr 1fr;
    }

    .program-container {
        grid-template-columns: 1fr 1fr;
    }

    .facility-container {
        grid-template-columns: 1fr 1fr;
    }

    .statistics {
        grid-template-columns: 1fr 1fr;
    }

    .stat:nth-child(2) {
        border-right: none;
    }

    .about-container {
        grid-template-columns: 1fr;
    }

    .contact-container {
        grid-template-columns: 1fr;
    }
}


/* =========================
   MOBILE
========================= */

@media (max-width: 650px) {

    .top-bar {
        display: none;
    }

    .navbar {
        padding: 12px 20px;
    }

    .logo h2 {
        font-size: 16px;
    }

    .logo span {
        font-size: 8px;
    }

    .menu-btn {
        display: block;
    }

    .nav-links {
        display: none;

        position: absolute;

        top: 79px;

        left: 0;

        width: 100%;

        background: white;

        flex-direction: column;

        text-align: center;

        gap: 0;

        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
    }

    .nav-links.active {
        display: flex;
    }

    .nav-links li {
        padding: 13px;

        border-bottom: 1px solid #eee;
    }

    .hero {
        min-height: 75vh;
    }

    .hero h1 {
        font-size: 42px;
    }

    .hero-content > p:not(.hero-small) {
        font-size: 16px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: center;
    }

    .notice {
        flex-direction: column;
        align-items: stretch;
    }

    .notice-title {
        text-align: center;
    }

    section {
        padding: 60px 5%;
    }

    .section-heading h2,
    .contact h2 {
        font-size: 30px;
    }

    .department-container,
    .program-container,
    .facility-container {
        grid-template-columns: 1fr;
    }

    .statistics {
        grid-template-columns: 1fr 1fr;
        padding: 40px 5%;
    }

    .stat {
        border-right: none;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    #admissionForm {
        padding: 25px;
    }
}